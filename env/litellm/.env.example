# Copy to .env and fill in. Used by the LiteLLM proxy for the Conductor OSS route (integration/README.md).
#
#   docker network create ml4-net
#   docker run -d --name ml4-litellm --network ml4-net -p 4000:4000 --env-file env/litellm/.env \
#     -v "$PWD/env/litellm/config.yaml:/app/config.yaml" ghcr.io/berriai/litellm:main-stable \
#     --config /app/config.yaml --port 4000
#
# Then run Conductor OSS on the same network with
#   -e CONDUCTOR_AI_LITELLM_BASEURL=http://ml4-litellm:4000 -e CONDUCTOR_AI_LITELLM_APIKEY=<LITELLM_MASTER_KEY value>
MISTRAL_API_KEY=
LITELLM_MASTER_KEY=
