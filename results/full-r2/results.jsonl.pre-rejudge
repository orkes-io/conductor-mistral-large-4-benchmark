{"run_id": "full-r2", "item_id": "coding-005", "category": "coding", "title": "Strict CSV line parser", "difficulty": "medium", "repeat": 1, "config_id": "l4_off", "config_label": "Mistral Large 4 (reasoning off)", "model": "mistral-large-4", "reasoning_effort": "none", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 2401, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 406, "reasoning_tokens": 0, "input_tokens": 244, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 1879, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 17, "failures": [], "pass": true, "load_error": null, "passed": 17}, "workflow_id": "0sfjbdb11ab8-d02a-11f1-89ad-1a5d2f4e051b", "parent_workflow_id": "0sfjbd824cbb-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:15:44-0500", "answer": "```python\ndef parse_csv_line(line: str, delimiter: str = \",\") -> list[str]:\n    if len(delimiter) != 1 or delimiter == '\"':\n        raise ValueError(\"delimiter must be a single character other than '\\\"'\")\n\n    fields: list[str] = []\n    i = 0\n    n = len(line)\n\n    while True:\n        # Start of a field\n        if i < n and line[i] == '\"':\n            # Quoted field\n            i += 1\n            buf: list[str] = []\n            closed = False\n            while i < n:\n                c = line[i]\n                if c == '\"':\n                    if i + 1 < n and line[i + 1] == '\"':\n                        buf.append('\"')\n                        i += 2\n                    else:\n                        # Closing quote\n                        i += 1\n                        closed = True\n                        break\n                else:\n                    buf.append(c)\n                    i += 1\n            if not closed:\n                raise ValueError(\"unterminated quoted field\")\n            # After closing quote must be delimiter or end of line\n            if i < n and line[i] != delimiter:\n                raise ValueError(\"unexpected character after closing quote\")\n            fields.append(\"\".join(buf))\n        else:\n            # Unquoted field\n            start = i\n            while i < n and line[i] != delimiter:\n                if line[i] == '\"':\n                    raise ValueError(\"unescaped quote in unquoted field\")\n                i += 1\n            fields.append(line[start:i])\n\n        # After field: either delimiter (continue) or end of line (finish)\n        if i < n and line[i] == delimiter:\n            i += 1\n            # If delimiter is at end, this creates a trailing empty field\n            if i == n:\n                fields.append(\"\")\n                break\n            continue\n        else:\n            break\n\n    return fields\n```"}
{"run_id": "full-r2", "item_id": "coding-005", "category": "coding", "title": "Strict CSV line parser", "difficulty": "medium", "repeat": 1, "config_id": "sol_low", "config_label": "GPT-6.1 Sol (reasoning low)", "model": "gpt-6.1-sol", "reasoning_effort": "low", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 2792, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 301, "reasoning_tokens": 0, "input_tokens": 245, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 1325, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 17, "failures": [], "pass": true, "load_error": null, "passed": 17}, "workflow_id": "0sfjbdb11aba-d02a-11f1-89ad-1a5d2f4e051b", "parent_workflow_id": "0sfjbd824cbb-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:15:45-0500", "answer": "```python\ndef parse_csv_line(line: str, delimiter: str = \",\") -> list[str]:\n    if not isinstance(delimiter, str) or len(delimiter) != 1 or delimiter == '\"':\n        raise ValueError('delimiter must be a single character other than \\'\"\\'')\n    \n    fields: list[str] = []\n    i = 0\n    n = len(line)\n\n    while True:\n        if i < n and line[i] == '\"':\n            i += 1\n            chars: list[str] = []\n\n            while True:\n                if i == n:\n                    raise ValueError(\"Unterminated quoted field\")\n\n                if line[i] != '\"':\n                    chars.append(line[i])\n                    i += 1\n                elif i + 1 < n and line[i + 1] == '\"':\n                    chars.append('\"')\n                    i += 2\n                else:\n                    i += 1\n                    break\n\n            if i < n and line[i] != delimiter:\n                raise ValueError(\"Closing quote must be followed by delimiter or end of line\")\n\n            fields.append(\"\".join(chars))\n        else:\n            start = i\n            while i < n and line[i] != delimiter:\n                if line[i] == '\"':\n                    raise ValueError(\"Quote in unquoted field\")\n                i += 1\n            fields.append(line[start:i])\n\n        if i == n:\n            return fields\n\n        i += 1\n```"}
{"run_id": "full-r2", "item_id": "coding-006", "category": "coding", "title": "RFC 6901 JSON Pointer lookup", "difficulty": "medium", "repeat": 1, "config_id": "l4_off", "config_label": "Mistral Large 4 (reasoning off)", "model": "mistral-large-4", "reasoning_effort": "none", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 2352, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 396, "reasoning_tokens": 0, "input_tokens": 322, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 1835, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 18, "failures": [], "pass": true, "load_error": null, "passed": 18}, "workflow_id": "0sfjbf0c6f49-d02a-11f1-ba7a-56adf5b8ca14", "parent_workflow_id": "0sfjbd824cbc-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:15:47-0500", "answer": "```python\ndef resolve_pointer(doc, pointer: str):\n    if pointer == \"\":\n        return doc\n\n    if not pointer.startswith(\"/\"):\n        raise ValueError(\"pointer must start with '/' or be empty\")\n\n    current = doc\n    # Split on '/'; the first element is empty due to leading '/'\n    tokens = pointer.split(\"/\")[1:]\n\n    for token in tokens:\n        # Decode ~1 before ~0\n        decoded = []\n        i = 0\n        while i < len(token):\n            ch = token[i]\n            if ch == \"~\":\n                if i + 1 >= len(token):\n                    raise ValueError(\"invalid escape: '~' at end of token\")\n                nxt = token[i + 1]\n                if nxt == \"1\":\n                    decoded.append(\"/\")\n                    i += 2\n                elif nxt == \"0\":\n                    decoded.append(\"~\")\n                    i += 2\n                else:\n                    raise ValueError(\"invalid escape: '~' followed by \" + repr(nxt))\n            else:\n                decoded.append(ch)\n                i += 1\n        key = \"\".join(decoded)\n\n        if isinstance(current, dict):\n            if key not in current:\n                raise KeyError(key)\n            current = current[key]\n        elif isinstance(current, list):\n            if key == \"-\":\n                raise KeyError(key)\n            # Must be ASCII digits, no leading zeros unless \"0\" itself\n            if not key.isascii() or not key.isdigit():\n                raise ValueError(\"invalid array index: \" + repr(key))\n            if len(key) > 1 and key[0] == \"0\":\n                raise ValueError(\"invalid array index with leading zero: \" + repr(key))\n            idx = int(key)\n            if idx >= len(current):\n                raise KeyError(key)\n            current = current[idx]\n        else:\n            raise KeyError(key)\n\n    return current\n```"}
{"run_id": "full-r2", "item_id": "coding-012", "category": "coding", "title": "Token bucket rate limiter", "difficulty": "medium", "repeat": 1, "config_id": "l4_off", "config_label": "Mistral Large 4 (reasoning off)", "model": "mistral-large-4", "reasoning_effort": "none", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 1918, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 231, "reasoning_tokens": 0, "input_tokens": 249, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 980, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 13, "failures": [], "pass": true, "load_error": null, "passed": 13}, "workflow_id": "0sfjbfbc105d-d02a-11f1-ba7a-56adf5b8ca14", "parent_workflow_id": "0sfjbd8273ce-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:15:47-0500", "answer": "```python\ndef token_bucket(capacity: int, refill_per_sec: float, requests: list[tuple[float, int]]) -> list[bool]:\n    if capacity < 1:\n        raise ValueError(\"capacity must be >= 1\")\n    if refill_per_sec < 0:\n        raise ValueError(\"refill_per_sec must be >= 0\")\n\n    tokens = float(capacity)\n    last_time = None\n    result = []\n\n    for timestamp, cost in requests:\n        if not isinstance(cost, int) or isinstance(cost, bool) or cost < 1:\n            raise ValueError(\"cost must be an integer >= 1\")\n        if last_time is not None and timestamp < last_time:\n            raise ValueError(\"timestamps must be non-decreasing\")\n\n        if last_time is not None:\n            elapsed = timestamp - last_time\n            tokens = min(float(capacity), tokens + elapsed * refill_per_sec)\n\n        last_time = timestamp\n\n        if tokens >= cost:\n            tokens -= cost\n            result.append(True)\n        else:\n            result.append(False)\n\n    return result\n```"}
{"run_id": "full-r2", "item_id": "coding-010", "category": "coding", "title": "Optimal string alignment distance", "difficulty": "medium", "repeat": 1, "config_id": "l4_off", "config_label": "Mistral Large 4 (reasoning off)", "model": "mistral-large-4", "reasoning_effort": "none", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 3574, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 471, "reasoning_tokens": 0, "input_tokens": 152, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 1573, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 13, "failures": [], "pass": true, "load_error": null, "passed": 13}, "workflow_id": "0sfjc0874580-d02a-11f1-89ad-1a5d2f4e051b", "parent_workflow_id": "0sfjbd8273cf-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:15:51-0500", "answer": "```python\ndef osa_distance(a: str, b: str) -> int:\n    \"\"\"\n    Compute the Optimal String Alignment (OSA) distance between two strings.\n\n    OSA distance is the restricted Damerau-Levenshtein distance: the minimum\n    number of insertions, deletions, substitutions, or transpositions of two\n    adjacent characters needed to turn `a` into `b`, with the restriction that\n    no substring is edited more than once (a transposed pair cannot take part\n    in any further edit).\n\n    Comparison is case-sensitive and operates on Python string characters\n    (Unicode code points).\n    \"\"\"\n    m, n = len(a), len(b)\n\n    # dp[i][j] = OSA distance between a[:i] and b[:j]\n    dp = [[0] * (n + 1) for _ in range(m + 1)]\n\n    # Base cases: converting empty string to prefix of the other\n    for i in range(m + 1):\n        dp[i][0] = i\n    for j in range(n + 1):\n        dp[0][j] = j\n\n    for i in range(1, m + 1):\n        for j in range(1, n + 1):\n            cost = 0 if a[i - 1] == b[j - 1] else 1\n\n            # Standard Levenshtein operations\n            dp[i][j] = min(\n                dp[i - 1][j] + 1,      # deletion\n                dp[i][j - 1] + 1,      # insertion\n                dp[i - 1][j - 1] + cost  # substitution (or match)\n            )\n\n            # Transposition of two adjacent characters (OSA restriction)\n            # Only allowed if i >= 2 and j >= 2, and the characters are swapped\n            if i >= 2 and j >= 2 and a[i - 1] == b[j - 2] and a[i - 2] == b[j - 1]:\n                dp[i][j] = min(dp[i][j], dp[i - 2][j - 2] + 1)\n\n    return dp[m][n]\n```"}
{"run_id": "full-r2", "item_id": "coding-005", "category": "coding", "title": "Strict CSV line parser", "difficulty": "medium", "repeat": 1, "config_id": "sol_high", "config_label": "GPT-6.1 Sol (reasoning high)", "model": "gpt-6.1-sol", "reasoning_effort": "high", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 9332, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 585, "reasoning_tokens": 279, "input_tokens": 245, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 1309, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 17, "failures": [], "pass": true, "load_error": null, "passed": 17}, "workflow_id": "0sfjbdb11ab9-d02a-11f1-89ad-1a5d2f4e051b", "parent_workflow_id": "0sfjbd824cbb-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:15:51-0500", "answer": "```python\ndef parse_csv_line(line: str, delimiter: str = \",\") -> list[str]:\n    if not isinstance(delimiter, str) or len(delimiter) != 1 or delimiter == '\"':\n        raise ValueError('Delimiter must be a single character other than \\'\"\\'') \n\n    fields: list[str] = []\n    i = 0\n    n = len(line)\n\n    while True:\n        if i < n and line[i] == '\"':\n            i += 1\n            chars: list[str] = []\n\n            while i < n:\n                if line[i] != '\"':\n                    chars.append(line[i])\n                    i += 1\n                elif i + 1 < n and line[i + 1] == '\"':\n                    chars.append('\"')\n                    i += 2\n                else:\n                    i += 1\n                    break\n            else:\n                raise ValueError(\"Unterminated quoted field\")\n\n            if i < n and line[i] != delimiter:\n                raise ValueError(\"Closing quote must be followed by delimiter or end of line\")\n\n            fields.append(\"\".join(chars))\n        else:\n            start = i\n            while i < n and line[i] != delimiter:\n                if line[i] == '\"':\n                    raise ValueError(\"Quote in unquoted field\")\n                i += 1\n            fields.append(line[start:i])\n\n        if i == n:\n            return fields\n\n        i += 1\n```"}
{"run_id": "full-r2", "item_id": "coding-006", "category": "coding", "title": "RFC 6901 JSON Pointer lookup", "difficulty": "medium", "repeat": 1, "config_id": "sol_low", "config_label": "GPT-6.1 Sol (reasoning low)", "model": "gpt-6.1-sol", "reasoning_effort": "low", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 7304, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 436, "reasoning_tokens": 157, "input_tokens": 325, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 1195, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 18, "failures": [], "pass": true, "load_error": null, "passed": 18}, "workflow_id": "0sfjbf0c965c-d02a-11f1-ba7a-56adf5b8ca14", "parent_workflow_id": "0sfjbd824cbc-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:15:51-0500", "answer": "```python\nimport re\n\n\ndef resolve_pointer(doc, pointer: str):\n    if pointer == \"\":\n        return doc\n    if not pointer.startswith(\"/\"):\n        raise ValueError(\"JSON Pointer must be empty or start with '/'\")\n\n    tokens = pointer.split(\"/\")[1:]\n    for i, token in enumerate(tokens):\n        if re.search(r\"~(?:[^01]|$)\", token):\n            raise ValueError(f\"Invalid escape in token: {token!r}\")\n        tokens[i] = token.replace(\"~1\", \"/\").replace(\"~0\", \"~\")\n\n    value = doc\n    for token in tokens:\n        if isinstance(value, dict):\n            value = value[token]\n        elif isinstance(value, list):\n            if token == \"-\":\n                raise KeyError(token)\n            if re.fullmatch(r\"(?:0|[1-9][0-9]*)\", token) is None:\n                raise ValueError(f\"Invalid array index: {token!r}\")\n\n            # Check bounds before conversion, including for enormous indices.\n            limit = str(len(value))\n            if len(token) > len(limit) or (\n                len(token) == len(limit) and token >= limit\n            ):\n                raise KeyError(token)\n            value = value[int(token)]\n        else:\n            raise KeyError(token)\n\n    return value\n```"}
{"run_id": "full-r2", "item_id": "coding-012", "category": "coding", "title": "Token bucket rate limiter", "difficulty": "medium", "repeat": 1, "config_id": "sol_low", "config_label": "GPT-6.1 Sol (reasoning low)", "model": "gpt-6.1-sol", "reasoning_effort": "low", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 6321, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 379, "reasoning_tokens": 104, "input_tokens": 252, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 1223, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 13, "failures": [], "pass": true, "load_error": null, "passed": 13}, "workflow_id": "0sfjbfbc105e-d02a-11f1-ba7a-56adf5b8ca14", "parent_workflow_id": "0sfjbd8273ce-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:15:52-0500", "answer": "```python\nfrom fractions import Fraction\n\n\ndef token_bucket(\n    capacity: int,\n    refill_per_sec: float,\n    requests: list[tuple[float, int]],\n) -> list[bool]:\n    if capacity < 1:\n        raise ValueError(\"capacity must be at least 1\")\n    if refill_per_sec < 0:\n        raise ValueError(\"refill_per_sec must be non-negative\")\n\n    if not requests:\n        return []\n\n    # Preserve the exact values represented by the input floats.\n    rate = Fraction(refill_per_sec)\n    tokens = Fraction(capacity)\n    previous_time = None\n    results: list[bool] = []\n\n    for timestamp, cost in requests:\n        if not isinstance(cost, int) or cost < 1:\n            raise ValueError(\"each cost must be an integer >= 1\")\n\n        current_time = Fraction(timestamp)\n        if previous_time is not None:\n            if current_time < previous_time:\n                raise ValueError(\"timestamps must be non-decreasing\")\n            tokens = min(\n                Fraction(capacity),\n                tokens + (current_time - previous_time) * rate,\n            )\n\n        previous_time = current_time\n        allowed = tokens >= cost\n        if allowed:\n            tokens -= cost\n        results.append(allowed)\n\n    return results\n```"}
{"run_id": "full-r2", "item_id": "coding-011", "category": "coding", "title": "Add business days with holidays", "difficulty": "medium", "repeat": 1, "config_id": "l4_off", "config_label": "Mistral Large 4 (reasoning off)", "model": "mistral-large-4", "reasoning_effort": "none", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 2516, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 433, "reasoning_tokens": 0, "input_tokens": 228, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 1751, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 15, "failures": [], "pass": true, "load_error": null, "passed": 15}, "workflow_id": "0sfjc1495d1d-d02a-11f1-89ad-1a5d2f4e051b", "parent_workflow_id": "0sfjbd8273d2-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:15:54-0500", "answer": "```python\nimport datetime\n\ndef add_business_days(start: str, days: int, holidays: list[str]) -> str:\n    def parse_date(s: str) -> datetime.date:\n        if not isinstance(s, str):\n            raise ValueError(f\"Invalid date: {s!r}\")\n        try:\n            # Strict parsing: must be exactly YYYY-MM-DD\n            if len(s) != 10 or s[4] != '-' or s[7] != '-':\n                raise ValueError\n            d = datetime.date.fromisoformat(s)\n            # fromisoformat is lenient in some Python versions; verify round-trip\n            if d.isoformat() != s:\n                raise ValueError\n            return d\n        except (ValueError, TypeError):\n            raise ValueError(f\"Invalid date format: {s!r}, expected YYYY-MM-DD\")\n\n    start_date = parse_date(start)\n    holiday_set = set()\n    for h in holidays:\n        holiday_set.add(parse_date(h))\n\n    def is_business_day(d: datetime.date) -> bool:\n        return d.weekday() < 5 and d not in holiday_set\n\n    if days == 0:\n        if is_business_day(start_date):\n            return start_date.isoformat()\n        # Find first business day after start\n        d = start_date + datetime.timedelta(days=1)\n        while not is_business_day(d):\n            d += datetime.timedelta(days=1)\n        return d.isoformat()\n\n    if days > 0:\n        d = start_date\n        count = 0\n        while count < days:\n            d += datetime.timedelta(days=1)\n            if is_business_day(d):\n                count += 1\n        return d.isoformat()\n    else:  # days < 0\n        d = start_date\n        count = 0\n        target = -days\n        while count < target:\n            d -= datetime.timedelta(days=1)\n            if is_business_day(d):\n                count += 1\n        return d.isoformat()\n```"}
{"run_id": "full-r2", "item_id": "coding-011", "category": "coding", "title": "Add business days with holidays", "difficulty": "medium", "repeat": 1, "config_id": "sol_low", "config_label": "GPT-6.1 Sol (reasoning low)", "model": "gpt-6.1-sol", "reasoning_effort": "low", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 2667, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 239, "reasoning_tokens": 0, "input_tokens": 230, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 963, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 15, "failures": [], "pass": true, "load_error": null, "passed": 15}, "workflow_id": "0sfjc1495d1a-d02a-11f1-89ad-1a5d2f4e051b", "parent_workflow_id": "0sfjbd8273d2-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:15:54-0500", "answer": "```python\nimport re\nfrom datetime import date, timedelta\n\n\ndef add_business_days(start: str, days: int, holidays: list[str]) -> str:\n    def parse_date(value: str) -> date:\n        if not isinstance(value, str) or re.fullmatch(\n            r\"[0-9]{4}-[0-9]{2}-[0-9]{2}\", value\n        ) is None:\n            raise ValueError(f\"Invalid date: {value!r}\")\n        return date.fromisoformat(value)\n\n    current = parse_date(start)\n    holiday_dates = {parse_date(holiday) for holiday in holidays}\n\n    def is_business_day(value: date) -> bool:\n        return value.weekday() < 5 and value not in holiday_dates\n\n    if days == 0:\n        while not is_business_day(current):\n            current += timedelta(days=1)\n    else:\n        step = timedelta(days=1 if days > 0 else -1)\n        remaining = abs(days)\n        while remaining:\n            current += step\n            if is_business_day(current):\n                remaining -= 1\n\n    return current.isoformat()\n```"}
{"run_id": "full-r2", "item_id": "coding-010", "category": "coding", "title": "Optimal string alignment distance", "difficulty": "medium", "repeat": 1, "config_id": "sol_high", "config_label": "GPT-6.1 Sol (reasoning high)", "model": "gpt-6.1-sol", "reasoning_effort": "high", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 9307, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 551, "reasoning_tokens": 261, "input_tokens": 155, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 1044, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 13, "failures": [], "pass": true, "load_error": null, "passed": 13}, "workflow_id": "0sfjc087457e-d02a-11f1-89ad-1a5d2f4e051b", "parent_workflow_id": "0sfjbd8273cf-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:15:56-0500", "answer": "```python\ndef osa_distance(a: str, b: str) -> int:\n    \"\"\"Return the optimal string alignment distance between a and b.\"\"\"\n    if a == b:\n        return 0\n\n    # Keep the shorter string in the columns to minimize memory usage.\n    if len(a) < len(b):\n        a, b = b, a\n    if not b:\n        return len(a)\n\n    n = len(b)\n    previous = list(range(n + 1))\n    two_back = previous\n\n    for i, char_a in enumerate(a, start=1):\n        current = [i] + [0] * n\n\n        for j, char_b in enumerate(b, start=1):\n            current[j] = min(\n                previous[j] + 1,                  # Deletion\n                current[j - 1] + 1,               # Insertion\n                previous[j - 1] + (char_a != char_b),  # Substitution\n            )\n\n            if (\n                i > 1\n                and j > 1\n                and char_a == b[j - 2]\n                and a[i - 2] == char_b\n            ):\n                current[j] = min(current[j], two_back[j - 2] + 1)\n\n        two_back, previous = previous, current\n\n    return previous[n]\n```"}
{"run_id": "full-r2", "item_id": "coding-010", "category": "coding", "title": "Optimal string alignment distance", "difficulty": "medium", "repeat": 1, "config_id": "sol_low", "config_label": "GPT-6.1 Sol (reasoning low)", "model": "gpt-6.1-sol", "reasoning_effort": "low", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 2857, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 276, "reasoning_tokens": 0, "input_tokens": 155, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 1042, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 13, "failures": [], "pass": true, "load_error": null, "passed": 13}, "workflow_id": "0sfjc0871e6d-d02a-11f1-89ad-1a5d2f4e051b", "parent_workflow_id": "0sfjbd8273cf-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:15:57-0500", "answer": "```python\ndef osa_distance(a: str, b: str) -> int:\n    if a == b:\n        return 0\n\n    # Keep the shorter string in the columns to minimize memory usage.\n    if len(a) < len(b):\n        a, b = b, a\n\n    n = len(b)\n    if n == 0:\n        return len(a)\n\n    previous_previous = None\n    previous = list(range(n + 1))\n\n    for i, char_a in enumerate(a, 1):\n        current = [i] + [0] * n\n        for j, char_b in enumerate(b, 1):\n            current[j] = min(\n                previous[j] + 1,                  # Deletion\n                current[j - 1] + 1,               # Insertion\n                previous[j - 1] + (char_a != char_b),  # Substitution\n            )\n            if (\n                i > 1\n                and j > 1\n                and char_a == b[j - 2]\n                and a[i - 2] == char_b\n            ):\n                current[j] = min(\n                    current[j],\n                    previous_previous[j - 2] + 1,\n                )\n\n        previous_previous, previous = previous, current\n\n    return previous[n]\n```"}
{"run_id": "full-r2", "item_id": "coding-008", "category": "coding", "title": "Subtract IPv4 CIDR blocks", "difficulty": "medium", "repeat": 1, "config_id": "l4_off", "config_label": "Mistral Large 4 (reasoning off)", "model": "mistral-large-4", "reasoning_effort": "none", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 11829, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 1426, "reasoning_tokens": 0, "input_tokens": 221, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 5679, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 17, "failures": [], "pass": true, "load_error": null, "passed": 17}, "workflow_id": "0sfjbffdfb7b-d02a-11f1-ba7a-56adf5b8ca14", "parent_workflow_id": "0sfjbd8273d1-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:15:58-0500", "answer": "I'll write a function that handles CIDR subtraction by converting to integer ranges, subtracting, and converting back.\n\n```python\nimport ipaddress\n\ndef cidr_subtract(base: str, remove: list[str]) -> list[str]:\n    def parse_cidr(s: str) -> tuple[int, int]:\n        \"\"\"Parse a CIDR string, return (start_int, end_int) inclusive. Raise ValueError if malformed.\"\"\"\n        if not isinstance(s, str):\n            raise ValueError(f\"Not a string: {s!r}\")\n\n        # Check for IPv6 (contains ':')\n        if ':' in s:\n            raise ValueError(f\"IPv6 not allowed: {s}\")\n\n        # Must have exactly one '/'\n        if s.count('/') != 1:\n            raise ValueError(f\"Missing or multiple '/': {s}\")\n\n        addr_part, prefix_part = s.split('/')\n\n        # Parse prefix length\n        if not prefix_part.isdigit():\n            raise ValueError(f\"Invalid prefix length: {prefix_part}\")\n        prefix = int(prefix_part)\n        if prefix < 0 or prefix > 32:\n            raise ValueError(f\"Prefix length out of range: {prefix}\")\n\n        # Parse address - must be exactly 4 octets\n        octets = addr_part.split('.')\n        if len(octets) != 4:\n            raise ValueError(f\"Not exactly 4 octets: {addr_part}\")\n\n        octet_vals = []\n        for octet in octets:\n            # Check for empty, non-digit, or leading zeros (except \"0\" itself)\n            if not octet.isdigit():\n                raise ValueError(f\"Invalid octet: {octet}\")\n            if len(octet) > 1 and octet[0] == '0':\n                raise ValueError(f\"Leading zero in octet: {octet}\")\n            val = int(octet)\n            if val < 0 or val > 255:\n                raise ValueError(f\"Octet out of range: {val}\")\n            octet_vals.append(val)\n\n        # Calculate network address as integer\n        addr_int = (octet_vals[0] << 24) | (octet_vals[1] << 16) | (octet_vals[2] << 8) | octet_vals[3]\n\n        # Check host bits are not set\n        host_bits = 32 - prefix\n        if host_bits > 0:\n            mask = (1 << host_bits) - 1\n            if addr_int & mask:\n                raise ValueError(f\"Host bits set: {s}\")\n\n        # Calculate range\n        network_int = addr_int  # already masked since host bits are 0\n        size = 1 << host_bits\n        start = network_int\n        end = network_int + size - 1\n\n        return (start, end)\n\n    def int_to_cidr(start: int, end: int) -> list[str]:\n        \"\"\"Convert an inclusive integer range to minimal list of CIDR blocks.\"\"\"\n        result = []\n        while start <= end:\n            # Find the largest block starting at 'start' that fits in [start, end]\n            # The block size is limited by: (1) alignment of start, (2) remaining range\n\n            # Maximum size based on alignment (lowest set bit)\n            # start & -start gives the lowest set bit, but we need to handle start=0\n            if start == 0:\n                max_align = 1 << 32  # entire space\n            else:\n                max_align = start & -start  # lowest set bit\n\n            # Maximum size based on remaining range\n            remaining = end - start + 1\n            max_size = 1\n            while max_size * 2 <= remaining and max_size * 2 <= max_align:\n                max_size *= 2\n\n            # Find the prefix length\n            size = max_size\n            prefix = 32\n            while size > 1:\n                size >>= 1\n                prefix -= 1\n\n            # Format the CIDR\n            octets = [\n                (start >> 24) & 0xFF,\n                (start >> 16) & 0xFF,\n                (start >> 8) & 0xFF,\n                start & 0xFF\n            ]\n            cidr = f\"{octets[0]}.{octets[1]}.{octets[2]}.{octets[3]}/{prefix}\"\n            result.append(cidr)\n\n            start += max_size\n\n        return result\n\n    # Parse base\n    base_start, base_end = parse_cidr(base)\n\n    # Parse all remove blocks, collect their ranges\n    remove_ranges = []\n    for block in remove:\n        r_start, r_end = parse_cidr(block)\n        remove_ranges.append((r_start,"}
{"run_id": "full-r2", "item_id": "coding-008", "category": "coding", "title": "Subtract IPv4 CIDR blocks", "difficulty": "medium", "repeat": 1, "config_id": "sol_low", "config_label": "GPT-6.1 Sol (reasoning low)", "model": "gpt-6.1-sol", "reasoning_effort": "low", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 12129, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 875, "reasoning_tokens": 276, "input_tokens": 224, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 2120, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 17, "failures": [], "pass": true, "load_error": null, "passed": 17}, "workflow_id": "0sfjbffdd468-d02a-11f1-ba7a-56adf5b8ca14", "parent_workflow_id": "0sfjbd8273d1-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:15:59-0500", "answer": "```python\nimport ipaddress\nimport re\n\n\n_CIDR_PATTERN = re.compile(\n    r\"(0|[1-9][0-9]{0,2})\\.\"\n    r\"(0|[1-9][0-9]{0,2})\\.\"\n    r\"(0|[1-9][0-9]{0,2})\\.\"\n    r\"(0|[1-9][0-9]{0,2})/([0-9]+)\"\n)\n\n\ndef _parse_cidr(block: str) -> ipaddress.IPv4Network:\n    if not isinstance(block, str):\n        raise ValueError(f\"Invalid IPv4 CIDR: {block!r}\")\n\n    match = _CIDR_PATTERN.fullmatch(block)\n    if match is None:\n        raise ValueError(f\"Invalid IPv4 CIDR: {block!r}\")\n\n    octets = [int(part) for part in match.groups()[:4]]\n    prefix_text = match.group(5).lstrip(\"0\") or \"0\"\n    if any(octet > 255 for octet in octets) or len(prefix_text) > 2:\n        raise ValueError(f\"Invalid IPv4 CIDR: {block!r}\")\n\n    prefix = int(prefix_text)\n    if prefix > 32:\n        raise ValueError(f\"Invalid IPv4 CIDR: {block!r}\")\n\n    address = 0\n    for octet in octets:\n        address = (address << 8) | octet\n\n    return ipaddress.IPv4Network((address, prefix), strict=True)\n\n\ndef cidr_subtract(base: str, remove: list[str]) -> list[str]:\n    base_network = _parse_cidr(base)\n    base_start = int(base_network.network_address)\n    base_end = int(base_network.broadcast_address)\n\n    intervals: list[tuple[int, int]] = []\n    for block in remove:\n        network = _parse_cidr(block)\n        start = max(base_start, int(network.network_address))\n        end = min(base_end, int(network.broadcast_address))\n        if start <= end:\n            intervals.append((start, end))\n\n    intervals.sort()\n    result: list[str] = []\n\n    def append_range(start: int, end: int) -> None:\n        result.extend(\n            str(network)\n            for network in ipaddress.summarize_address_range(\n                ipaddress.IPv4Address(start),\n                ipaddress.IPv4Address(end),\n            )\n        )\n\n    cursor = base_start\n    for start, end in intervals:\n        if end < cursor:\n            continue\n        if start > cursor:\n            append_range(cursor, start - 1)\n        cursor = end + 1\n        if cursor > base_end:\n            break\n\n    if cursor <= base_end:\n        append_range(cursor, base_end)\n\n    return result\n```"}
{"run_id": "full-r2", "item_id": "coding-009", "category": "coding", "title": "Exact arithmetic expression evaluator", "difficulty": "hard", "repeat": 1, "config_id": "sol_low", "config_label": "GPT-6.1 Sol (reasoning low)", "model": "gpt-6.1-sol", "reasoning_effort": "low", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 9019, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 736, "reasoning_tokens": 125, "input_tokens": 355, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 2624, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 20, "failures": [], "pass": true, "load_error": null, "passed": 20}, "workflow_id": "0sfjc13a516a-d02a-11f1-aff9-321d2204384c", "parent_workflow_id": "0sfjbd8273d0-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:16:01-0500", "answer": "```python\nfrom fractions import Fraction\n\n\ndef evaluate(expr: str) -> Fraction:\n    tokens: list[int | str | None] = []\n    i = 0\n\n    while i < len(expr):\n        ch = expr[i]\n        if ch.isspace():\n            i += 1\n        elif \"0\" <= ch <= \"9\":\n            value = 0\n            while i < len(expr) and \"0\" <= expr[i] <= \"9\":\n                value = value * 10 + ord(expr[i]) - ord(\"0\")\n                i += 1\n            tokens.append(value)\n        elif ch == \"*\" and i + 1 < len(expr) and expr[i + 1] == \"*\":\n            tokens.append(\"**\")\n            i += 2\n        elif ch in \"+-*/()\":\n            tokens.append(ch)\n            i += 1\n        else:\n            raise ValueError(f\"Unknown character: {ch!r}\")\n\n    tokens.append(None)\n    pos = 0\n\n    def parse_atom() -> Fraction:\n        nonlocal pos\n        token = tokens[pos]\n        if isinstance(token, int):\n            pos += 1\n            return Fraction(token)\n        if token == \"(\":\n            pos += 1\n            value = parse_sum()\n            if tokens[pos] != \")\":\n                raise ValueError(\"Missing closing parenthesis\")\n            pos += 1\n            return value\n        raise ValueError(\"Expected an integer or '('\")\n\n    def parse_power() -> Fraction:\n        nonlocal pos\n        base = parse_atom()\n        if tokens[pos] == \"**\":\n            pos += 1\n            exponent = parse_unary()\n            if exponent.denominator != 1:\n                raise ValueError(\"Exponent must be an integer\")\n            return base ** exponent.numerator\n        return base\n\n    def parse_unary() -> Fraction:\n        nonlocal pos\n        sign = 1\n        while tokens[pos] in (\"+\", \"-\"):\n            if tokens[pos] == \"-\":\n                sign = -sign\n            pos += 1\n        return sign * parse_power()\n\n    def parse_product() -> Fraction:\n        nonlocal pos\n        value = parse_unary()\n        while tokens[pos] in (\"*\", \"/\"):\n            operator = tokens[pos]\n            pos += 1\n            right = parse_unary()\n            if operator == \"*\":\n                value *= right\n            else:\n                value /= right\n        return value\n\n    def parse_sum() -> Fraction:\n        nonlocal pos\n        value = parse_product()\n        while tokens[pos] in (\"+\", \"-\"):\n            operator = tokens[pos]\n            pos += 1\n            right = parse_product()\n            if operator == \"+\":\n                value += right\n            else:\n                value -= right\n        return value\n\n    result = parse_sum()\n    if tokens[pos] is not None:\n        raise ValueError(\"Unexpected token\")\n    return result\n```"}
{"run_id": "full-r2", "item_id": "coding-006", "category": "coding", "title": "RFC 6901 JSON Pointer lookup", "difficulty": "medium", "repeat": 1, "config_id": "sol_high", "config_label": "GPT-6.1 Sol (reasoning high)", "model": "gpt-6.1-sol", "reasoning_effort": "high", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 17686, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 1101, "reasoning_tokens": 770, "input_tokens": 325, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 1423, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 18, "failures": [], "pass": true, "load_error": null, "passed": 18}, "workflow_id": "0sfjbf0c965b-d02a-11f1-ba7a-56adf5b8ca14", "parent_workflow_id": "0sfjbd824cbc-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:16:02-0500", "answer": "```python\ndef resolve_pointer(doc, pointer: str):\n    if pointer == \"\":\n        return doc\n    if not pointer.startswith(\"/\"):\n        raise ValueError(\"A non-empty JSON Pointer must start with '/'\")\n\n    value = doc\n    for raw_token in pointer.split(\"/\")[1:]:\n        i = 0\n        while i < len(raw_token):\n            if raw_token[i] == \"~\":\n                if i + 1 == len(raw_token) or raw_token[i + 1] not in \"01\":\n                    raise ValueError(f\"Invalid escape in token: {raw_token!r}\")\n                i += 2\n            else:\n                i += 1\n\n        token = raw_token.replace(\"~1\", \"/\").replace(\"~0\", \"~\")\n\n        if isinstance(value, dict):\n            value = value[token]\n        elif isinstance(value, list):\n            if token == \"-\":\n                raise KeyError(token)\n            if (\n                not token.isascii()\n                or not token.isdecimal()\n                or (len(token) > 1 and token[0] == \"0\")\n            ):\n                raise ValueError(f\"Invalid list index: {token!r}\")\n\n            # Check the range before int(), including for arbitrarily long tokens.\n            limit = str(len(value))\n            if len(token) > len(limit) or (\n                len(token) == len(limit) and token >= limit\n            ):\n                raise KeyError(token)\n\n            value = value[int(token)]\n        else:\n            raise KeyError(token)\n\n    return value\n```"}
{"run_id": "full-r2", "item_id": "coding-012", "category": "coding", "title": "Token bucket rate limiter", "difficulty": "medium", "repeat": 1, "config_id": "sol_high", "config_label": "GPT-6.1 Sol (reasoning high)", "model": "gpt-6.1-sol", "reasoning_effort": "high", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 16453, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 773, "reasoning_tokens": 512, "input_tokens": 252, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 1149, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 13, "failures": [], "pass": true, "load_error": null, "passed": 13}, "workflow_id": "0sfjbfbc105f-d02a-11f1-ba7a-56adf5b8ca14", "parent_workflow_id": "0sfjbd8273ce-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:16:02-0500", "answer": "```python\nfrom fractions import Fraction\n\n\ndef token_bucket(\n    capacity: int,\n    refill_per_sec: float,\n    requests: list[tuple[float, int]],\n) -> list[bool]:\n    if capacity < 1:\n        raise ValueError(\"capacity must be at least 1\")\n    if refill_per_sec < 0:\n        raise ValueError(\"refill_per_sec must be non-negative\")\n    if not requests:\n        return []\n\n    rate = Fraction(refill_per_sec)\n    tokens = Fraction(capacity)\n    previous_time = None\n    results: list[bool] = []\n\n    for timestamp, cost in requests:\n        if not isinstance(cost, int) or cost < 1:\n            raise ValueError(\"cost must be an integer at least 1\")\n\n        current_time = Fraction(timestamp)\n        if previous_time is not None:\n            if current_time < previous_time:\n                raise ValueError(\"timestamps must be non-decreasing\")\n            tokens = min(\n                capacity,\n                tokens + (current_time - previous_time) * rate,\n            )\n\n        allowed = tokens >= cost\n        if allowed:\n            tokens -= cost\n\n        results.append(allowed)\n        previous_time = current_time\n\n    return results\n```"}
{"run_id": "full-r2", "item_id": "coding-007", "category": "coding", "title": "Glob matching with character classes", "difficulty": "hard", "repeat": 1, "config_id": "sol_low", "config_label": "GPT-6.1 Sol (reasoning low)", "model": "gpt-6.1-sol", "reasoning_effort": "low", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 17872, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 973, "reasoning_tokens": 317, "input_tokens": 308, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 2918, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 20, "failures": [], "pass": true, "load_error": null, "passed": 20}, "workflow_id": "0sfjbef92b3c-d02a-11f1-89ad-1a5d2f4e051b", "parent_workflow_id": "0sfjbd824cbd-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:16:02-0500", "answer": "```python\ndef glob_match(pattern: str, name: str) -> bool:\n    \"\"\"Match all of name against a case-sensitive glob pattern.\"\"\"\n    n = len(name)\n    dp = [False] * (n + 1)\n    dp[0] = True\n    i = 0\n\n    while i < len(pattern):\n        ch = pattern[i]\n        i += 1\n        kind = \"literal\"\n        literal = ch\n        intervals = []\n        negated = False\n\n        if ch == \"\\\\\":\n            if i < len(pattern):\n                literal = pattern[i]\n                i += 1\n        elif ch == \"*\":\n            kind = \"star\"\n            if i < len(pattern) and pattern[i] == \"*\":\n                kind = \"globstar\"\n                i += 1\n        elif ch == \"?\":\n            kind = \"any\"\n        elif ch == \"[\":\n            start = i\n            if start < len(pattern) and pattern[start] in \"!^\":\n                negated = True\n                start += 1\n\n            # A leading ']' is a member, not the closing delimiter.\n            search_from = start\n            if search_from < len(pattern) and pattern[search_from] == \"]\":\n                search_from += 1\n            end = pattern.find(\"]\", search_from)\n\n            if end != -1:\n                kind = \"set\"\n                body = pattern[start:end]\n                k = 0\n                while k < len(body):\n                    first_literal_dash = k == 0 and body[k] == \"-\"\n                    last_literal_dash = (\n                        k + 2 == len(body) - 1 and body[k + 2] == \"-\"\n                    )\n                    if (\n                        k + 2 < len(body)\n                        and body[k + 1] == \"-\"\n                        and not first_literal_dash\n                        and not last_literal_dash\n                    ):\n                        intervals.append((ord(body[k]), ord(body[k + 2])))\n                        k += 3\n                    else:\n                        code = ord(body[k])\n                        intervals.append((code, code))\n                        k += 1\n                i = end + 1\n            # Otherwise '[' is literal; resume immediately after it.\n\n        next_dp = [False] * (n + 1)\n\n        if kind in (\"star\", \"globstar\"):\n            next_dp[0] = dp[0]\n            for j, char in enumerate(name, 1):\n                allowed = kind == \"globstar\" or char != \"/\"\n                next_dp[j] = dp[j] or (allowed and next_dp[j - 1])\n        else:\n            for j, char in enumerate(name, 1):\n                if not dp[j - 1]:\n                    continue\n                if kind == \"literal\":\n                    matches = char == literal\n                elif kind == \"any\":\n                    matches = char != \"/\"\n                else:\n                    code = ord(char)\n                    member = any(lo <= code <= hi for lo, hi in intervals)\n                    matches = char != \"/\" and (member != negated)\n                next_dp[j] = matches\n\n        dp = next_dp\n\n    return dp[n]\n```"}
{"run_id": "full-r2", "item_id": "coding-011", "category": "coding", "title": "Add business days with holidays", "difficulty": "medium", "repeat": 1, "config_id": "sol_high", "config_label": "GPT-6.1 Sol (reasoning high)", "model": "gpt-6.1-sol", "reasoning_effort": "high", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 11793, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 698, "reasoning_tokens": 446, "input_tokens": 230, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 1042, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 15, "failures": [], "pass": true, "load_error": null, "passed": 15}, "workflow_id": "0sfjc1495d1b-d02a-11f1-89ad-1a5d2f4e051b", "parent_workflow_id": "0sfjbd8273d2-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:16:04-0500", "answer": "```python\nfrom datetime import date, timedelta\n\n\ndef add_business_days(start: str, days: int, holidays: list[str]) -> str:\n    def parse_date(value: str) -> date:\n        try:\n            parsed = date.fromisoformat(value)\n        except (TypeError, ValueError) as exc:\n            raise ValueError(f\"Invalid date: {value!r}\") from exc\n        if parsed.isoformat() != value:\n            raise ValueError(f\"Date must use YYYY-MM-DD format: {value!r}\")\n        return parsed\n\n    current = parse_date(start)\n    holiday_dates = {parse_date(value) for value in holidays}\n\n    def is_business_day(value: date) -> bool:\n        return value.weekday() < 5 and value not in holiday_dates\n\n    if days == 0:\n        while not is_business_day(current):\n            current += timedelta(days=1)\n        return current.isoformat()\n\n    step = timedelta(days=1 if days > 0 else -1)\n    remaining = abs(days)\n\n    while remaining:\n        current += step\n        if is_business_day(current):\n            remaining -= 1\n\n    return current.isoformat()\n```"}
{"run_id": "full-r2", "item_id": "coding-009", "category": "coding", "title": "Exact arithmetic expression evaluator", "difficulty": "hard", "repeat": 1, "config_id": "l4_off", "config_label": "Mistral Large 4 (reasoning off)", "model": "mistral-large-4", "reasoning_effort": "none", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 11647, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 2007, "reasoning_tokens": 0, "input_tokens": 349, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 7477, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 20, "failures": [], "pass": true, "load_error": null, "passed": 20}, "workflow_id": "0sfjc13a5169-d02a-11f1-aff9-321d2204384c", "parent_workflow_id": "0sfjbd8273d0-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:16:05-0500", "answer": "I'll write a recursive descent parser for this arithmetic expression evaluator.\n\n```python\nfrom fractions import Fraction\n\ndef evaluate(expr: str) -> Fraction:\n    # Tokenizer\n    tokens = []\n    i = 0\n    n = len(expr)\n    while i < n:\n        c = expr[i]\n        if c.isspace():\n            i += 1\n            continue\n        if c.isdigit():\n            j = i\n            while j < n and expr[j].isdigit():\n                j += 1\n            tokens.append(('NUM', int(expr[i:j])))\n            i = j\n        elif c in '+-*/()':\n            if c == '*':\n                # Check for **\n                if i + 1 < n and expr[i + 1] == '*':\n                    tokens.append(('OP', '**'))\n                    i += 2\n                else:\n                    tokens.append(('OP', '*'))\n                    i += 1\n            else:\n                tokens.append(('OP', c))\n                i += 1\n        else:\n            raise ValueError(f\"Unknown character: {c!r}\")\n\n    if not tokens:\n        raise ValueError(\"Empty expression\")\n\n    # Parser state\n    pos = [0]  # mutable position\n\n    def peek():\n        if pos[0] < len(tokens):\n            return tokens[pos[0]]\n        return None\n\n    def consume():\n        tok = tokens[pos[0]]\n        pos[0] += 1\n        return tok\n\n    def expect_op(op):\n        tok = peek()\n        if tok is None or tok[0] != 'OP' or tok[1] != op:\n            raise ValueError(f\"Expected {op!r}\")\n        return consume()\n\n    # Grammar (precedence from lowest to highest):\n    # expr := term (('+' | '-') term)*\n    # term := factor (('*' | '/') factor)*\n    # factor := unary ('**' factor)?    -- right associative, but ** binds tighter than unary on left\n    # Actually: power := primary ('**' factor)?  -- right associative\n    #           unary := ('+' | '-') unary | power\n    # But ** binds tighter than unary minus: -2**2 = -(2**2)\n    # So: unary := ('+' | '-') unary | power\n    #     power := primary ('**' unary)?   -- right operand can have unary, and ** is right-assoc\n    # Wait, need to be careful. Let's think again.\n    #\n    # Precedence: ** > unary +/- > * / > binary +/-\n    # ** is right-associative\n    # -2**2 = -(2**2), so ** binds tighter than unary on the left\n    # 2**-1 = 2**(-1), so right operand of ** can start with unary\n    #\n    # So the structure is:\n    # expr := term (('+' | '-') term)*\n    # term := unary (('*' | '/') unary)*\n    # unary := ('+' | '-') unary | power\n    # power := primary ('**' unary)?    -- right-assoc because unary can contain power? No wait.\n    #\n    # Actually for right-associativity of **: 2**3**2 = 2**(3**2)\n    # The right operand of ** is itself a power expression (or unary which contains power)\n    #\n    # Let me redefine:\n    # unary := ('+' | '-') unary | power\n    # power := primary ('**' unary)?    -- this makes ** right-associative because unary -> power -> ...\n    #\n    # Check: 2**3**2\n    # power: primary=2, sees **, parses unary for right side\n    #   unary: no sign, so power\n    #     power: primary=3, sees **, parses unary for right side\n    #       unary: no sign, so power\n    #         power: primary=2, no **, returns 2\n    #       returns 2\n    #     returns 3**2 = 9\n    #   returns 9\n    # returns 2**9 = 512 \u2713\n    #\n    # Check: -2**2\n    # unary: sees -, parses unary\n    #   unary: no sign, so power\n    #     power: primary=2, sees **, parses unary\n    #       unary: no sign, power: primary=2, returns 2\n    #     returns 2**2 = 4\n    #   returns 4\n    # returns -4 \u2713\n    #\n    # Check: 2**-1\n    # power: primary=2, sees **, parses unary\n    #   unary: sees -, parses unary\n    #     unary: no sign, power: primary=1, returns 1\n    #   returns -1\n    # returns 2**(-1) = 1/2 \u2713\n\n    def parse_expr():\n        # expr := term (('+' | '-') term)*\n        result = parse_term()\n        while True:\n            tok = peek()\n            if tok is not None and tok[0] == 'OP' and tok[1] in ('+', '-'):\n                op = consume()[1]\n                right = parse_term()\n"}
{"run_id": "full-r2", "item_id": "coding-005", "category": "coding", "title": "Strict CSV line parser", "difficulty": "medium", "repeat": 1, "config_id": "l3", "config_label": "Mistral Large 3 (baseline)", "model": "mistral-large-2512", "reasoning_effort": null, "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 3621, "turns": 1, "retries": 1, "usage": {"search_calls": null, "output_tokens": 356, "reasoning_tokens": 0, "input_tokens": 246, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 1617, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 17, "failures": [], "pass": true, "load_error": null, "passed": 17}, "workflow_id": "0sfjbdb11abc-d02a-11f1-89ad-1a5d2f4e051b", "parent_workflow_id": "0sfjbd824cbb-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:16:06-0500", "answer": "```python\ndef parse_csv_line(line: str, delimiter: str = \",\") -> list[str]:\n    if len(delimiter) != 1 or delimiter == '\"':\n        raise ValueError(\"Delimiter must be a single character other than '\\\"'\")\n\n    fields = []\n    current_field = []\n    in_quotes = False\n    i = 0\n    n = len(line)\n\n    while i < n:\n        if not in_quotes:\n            if line[i] == '\"':\n                if current_field:\n                    raise ValueError(\"Unquoted field contains '\\\"'\")\n                in_quotes = True\n                i += 1\n            elif line[i] == delimiter:\n                fields.append(''.join(current_field))\n                current_field = []\n                i += 1\n            else:\n                current_field.append(line[i])\n                i += 1\n        else:\n            if line[i] == '\"':\n                if i + 1 < n and line[i + 1] == '\"':\n                    current_field.append('\"')\n                    i += 2\n                else:\n                    in_quotes = False\n                    i += 1\n                    # Check what follows the closing quote\n                    if i < n and line[i] != delimiter:\n                        if line[i] != '':\n                            raise ValueError(\"Closing quote must be followed by delimiter or end of line\")\n            else:\n                current_field.append(line[i])\n                i += 1\n\n    # After loop ends\n    if in_quotes:\n        raise ValueError(\"Unterminated quoted field\")\n\n    fields.append(''.join(current_field))\n\n    # Handle empty line case\n    if not line and not fields:\n        return [\"\"]\n\n    return fields\n```"}
{"run_id": "full-r2", "item_id": "coding-008", "category": "coding", "title": "Subtract IPv4 CIDR blocks", "difficulty": "medium", "repeat": 1, "config_id": "sol_high", "config_label": "GPT-6.1 Sol (reasoning high)", "model": "gpt-6.1-sol", "reasoning_effort": "high", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 20862, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 1200, "reasoning_tokens": 779, "input_tokens": 224, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 1645, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 17, "failures": [], "pass": true, "load_error": null, "passed": 17}, "workflow_id": "0sfjbffdfb7a-d02a-11f1-ba7a-56adf5b8ca14", "parent_workflow_id": "0sfjbd8273d1-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:16:07-0500", "answer": "```python\nimport re\nfrom ipaddress import IPv4Address, IPv4Network, summarize_address_range\n\n\ndef cidr_subtract(base: str, remove: list[str]) -> list[str]:\n    \"\"\"Return the minimal, address-sorted CIDR cover of base minus remove.\"\"\"\n    syntax = re.compile(\n        r\"(?:0|[1-9][0-9]{0,2})\"\n        r\"(?:\\.(?:0|[1-9][0-9]{0,2})){3}/[0-9]+\"\n    )\n\n    def parse(block: str) -> IPv4Network:\n        if not isinstance(block, str) or syntax.fullmatch(block) is None:\n            raise ValueError(f\"Malformed IPv4 CIDR block: {block!r}\")\n        return IPv4Network(block, strict=True)\n\n    network = parse(base)\n    base_start = int(network.network_address)\n    base_end = int(network.broadcast_address)\n\n    # Validate every block, even if an earlier block removes all of base.\n    intervals: list[tuple[int, int]] = []\n    for block in remove:\n        excluded = parse(block)\n        start = max(base_start, int(excluded.network_address))\n        end = min(base_end, int(excluded.broadcast_address))\n        if start <= end:\n            intervals.append((start, end))\n\n    intervals.sort()\n    result: list[str] = []\n\n    def append_range(start: int, end: int) -> None:\n        result.extend(\n            str(block)\n            for block in summarize_address_range(\n                IPv4Address(start), IPv4Address(end)\n            )\n        )\n\n    cursor = base_start\n    for start, end in intervals:\n        if start > cursor:\n            append_range(cursor, start - 1)\n        cursor = max(cursor, end + 1)\n        if cursor > base_end:\n            break\n\n    if cursor <= base_end:\n        append_range(cursor, base_end)\n\n    return result\n```"}
{"run_id": "full-r2", "item_id": "coding-012", "category": "coding", "title": "Token bucket rate limiter", "difficulty": "medium", "repeat": 1, "config_id": "l3", "config_label": "Mistral Large 3 (baseline)", "model": "mistral-large-2512", "reasoning_effort": null, "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 3452, "turns": 1, "retries": 1, "usage": {"search_calls": null, "output_tokens": 292, "reasoning_tokens": 0, "input_tokens": 257, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 1254, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 13, "failures": [], "pass": true, "load_error": null, "passed": 13}, "workflow_id": "0sfjbfbc3771-d02a-11f1-ba7a-56adf5b8ca14", "parent_workflow_id": "0sfjbd8273ce-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:16:09-0500", "answer": "```python\ndef token_bucket(capacity: int, refill_per_sec: float, requests: list[tuple[float, int]]) -> list[bool]:\n    if capacity < 1:\n        raise ValueError(\"Capacity must be at least 1\")\n    if refill_per_sec < 0:\n        raise ValueError(\"Refill rate must be non-negative\")\n\n    if not requests:\n        return []\n\n    # Validate requests\n    prev_timestamp = None\n    for timestamp, cost in requests:\n        if not isinstance(cost, int) or cost < 1:\n            raise ValueError(\"Cost must be an integer >= 1\")\n        if prev_timestamp is not None and timestamp < prev_timestamp:\n            raise ValueError(\"Timestamps must be non-decreasing\")\n        prev_timestamp = timestamp\n\n    tokens = capacity\n    last_refill_time = requests[0][0]\n    results = []\n\n    for timestamp, cost in requests:\n        # Calculate tokens added since last refill\n        time_elapsed = timestamp - last_refill_time\n        tokens_added = time_elapsed * refill_per_sec\n        tokens = min(tokens + tokens_added, capacity)\n        last_refill_time = timestamp\n\n        # Check if request can be allowed\n        if tokens >= cost:\n            tokens -= cost\n            results.append(True)\n        else:\n            results.append(False)\n\n    return results\n```"}
{"run_id": "full-r2", "item_id": "coding-006", "category": "coding", "title": "RFC 6901 JSON Pointer lookup", "difficulty": "medium", "repeat": 1, "config_id": "l3", "config_label": "Mistral Large 3 (baseline)", "model": "mistral-large-2512", "reasoning_effort": null, "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 5494, "turns": 1, "retries": 1, "usage": {"search_calls": null, "output_tokens": 456, "reasoning_tokens": 0, "input_tokens": 324, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 2141, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 18, "failures": [], "pass": true, "load_error": null, "passed": 18}, "workflow_id": "0sfjbf0c965d-d02a-11f1-ba7a-56adf5b8ca14", "parent_workflow_id": "0sfjbd824cbc-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:16:10-0500", "answer": "```python\nimport json\n\ndef resolve_pointer(doc, pointer: str):\n    if not isinstance(pointer, str):\n        raise ValueError(\"Pointer must be a string\")\n\n    if pointer == \"\":\n        return doc\n\n    if not pointer.startswith(\"/\"):\n        raise ValueError(\"Pointer must start with '/'\")\n\n    tokens = pointer.split(\"/\")[1:]  # Skip the initial empty string from leading '/'\n\n    current = doc\n    for token in tokens:\n        # Decode ~0 and ~1\n        decoded_token = []\n        i = 0\n        n = len(token)\n        while i < n:\n            if token[i] == '~':\n                if i + 1 >= n:\n                    raise ValueError(\"Invalid escape sequence in pointer\")\n                if token[i+1] == '0':\n                    decoded_token.append('~')\n                    i += 2\n                elif token[i+1] == '1':\n                    decoded_token.append('/')\n                    i += 2\n                else:\n                    raise ValueError(\"Invalid escape sequence in pointer\")\n            else:\n                decoded_token.append(token[i])\n                i += 1\n        decoded_token = ''.join(decoded_token)\n\n        if isinstance(current, dict):\n            if decoded_token not in current:\n                raise KeyError(f\"Key '{decoded_token}' not found in dictionary\")\n            current = current[decoded_token]\n        elif isinstance(current, list):\n            if decoded_token == \"-\":\n                raise KeyError(\"Index '-' refers to non-existent element after last list item\")\n            if not decoded_token.isdigit():\n                raise ValueError(f\"List index must be a non-negative integer, got '{decoded_token}'\")\n            if len(decoded_token) > 1 and decoded_token[0] == '0':\n                raise ValueError(f\"List index must not have leading zeros, got '{decoded_token}'\")\n            index = int(decoded_token)\n            if index >= len(current):\n                raise KeyError(f\"List index {index} out of range\")\n            current = current[index]\n        else:\n            raise KeyError(f\"Cannot index into {type(current).__name__} with token '{decoded_token}'\")\n\n    return current\n```"}
{"run_id": "full-r2", "item_id": "coding-007", "category": "coding", "title": "Glob matching with character classes", "difficulty": "hard", "repeat": 1, "config_id": "l3", "config_label": "Mistral Large 3 (baseline)", "model": "mistral-large-2512", "reasoning_effort": null, "pass": false, "score": 0.85, "api_ok": true, "error": null, "latency_ms": 6138, "turns": 1, "retries": 1, "usage": {"search_calls": null, "output_tokens": 560, "reasoning_tokens": 0, "input_tokens": 299, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 2428, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 0.85, "total": 20, "failures": [{"test": "assert glob_match(\"[]]x\", \"]x\")", "line": 11, "error": "PatternError: unterminated character set at position 1"}, {"test": "assert not glob_match(\"a[/]b\", \"a/b\")", "line": 16, "error": "AssertionError: "}, {"test": "assert not glob_match(\"[z-a]\", \"m\")", "line": 19, "error": "PatternError: bad character range z-a at position 2"}], "pass": false, "load_error": null, "passed": 17}, "workflow_id": "0sfjbef92b3b-d02a-11f1-89ad-1a5d2f4e051b", "parent_workflow_id": "0sfjbd824cbd-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:16:11-0500", "answer": "Here's the Python function `glob_match` that implements the specified glob pattern matching:\n\n```python\nimport re\n\ndef glob_match(pattern: str, name: str) -> bool:\n    def compile_pattern(p: str) -> str:\n        i = 0\n        n = len(p)\n        res = []\n        while i < n:\n            c = p[i]\n            if c == '\\\\':\n                if i + 1 < n:\n                    res.append(re.escape(p[i+1]))\n                    i += 2\n                else:\n                    res.append(re.escape('\\\\'))\n                    i += 1\n            elif c == '?':\n                res.append('[^/]')\n                i += 1\n            elif c == '*':\n                if i + 1 < n and p[i+1] == '*':\n                    res.append('.*')\n                    i += 2\n                else:\n                    res.append('[^/]*')\n                    i += 1\n            elif c == '[':\n                j = i + 1\n                if j < n and (p[j] == '!' or p[j] == '^'):\n                    j += 1\n                while j < n and p[j] != ']':\n                    if p[j] == '\\\\':\n                        j += 1\n                        if j < n:\n                            j += 1\n                    else:\n                        j += 1\n                if j >= n:\n                    res.append(re.escape('['))\n                    i += 1\n                else:\n                    set_content = p[i+1:j]\n                    if set_content.startswith('!') or set_content.startswith('^'):\n                        set_content = '^' + set_content[1:]\n                    res.append(f'[{set_content}]')\n                    i = j + 1\n            else:\n                res.append(re.escape(c))\n                i += 1\n        return '^' + ''.join(res) + '$'\n\n    regex = compile_pattern(pattern)\n    return bool(re.fullmatch(regex, name))\n```\n\nThis function works by:\n1. Converting the glob pattern into a regular expression pattern\n2. Using the `re.fullmatch` function to check if the entire name matches the converted pattern\n3. Handling all the special cases mentioned in the specification:\n   - `?` becomes `[^/]`\n   - `*` becomes `[^/]*`\n   - `**` becomes `.*`\n   - Character sets `[...]` are handled with proper escaping and negation\n   - Backslash escaping is properly handled both inside and outside sets\n   - Literal characters are escaped with `re.escape`\n\nThe function returns `True` if the entire name matches the pattern, and `False` otherwise."}
{"run_id": "full-r2", "item_id": "coding-008", "category": "coding", "title": "Subtract IPv4 CIDR blocks", "difficulty": "medium", "repeat": 1, "config_id": "l3", "config_label": "Mistral Large 3 (baseline)", "model": "mistral-large-2512", "reasoning_effort": null, "pass": false, "score": 0.9412, "api_ok": true, "error": null, "latency_ms": 5725, "turns": 1, "retries": 1, "usage": {"search_calls": null, "output_tokens": 507, "reasoning_tokens": 0, "input_tokens": 227, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 2269, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 0.9412, "total": 17, "failures": [{"test": "assert _raises(cidr_subtract, \"10.0.0.0\", [])", "line": 25, "error": "AssertionError: "}], "pass": false, "load_error": null, "passed": 16}, "workflow_id": "0sfjbffdd469-d02a-11f1-ba7a-56adf5b8ca14", "parent_workflow_id": "0sfjbd8273d1-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:16:12-0500", "answer": "Here's the Python function `cidr_subtract` that meets your requirements:\n\n```python\nimport ipaddress\n\ndef cidr_subtract(base: str, remove: list[str]) -> list[str]:\n    try:\n        base_net = ipaddress.IPv4Network(base, strict=True)\n    except ValueError as e:\n        raise ValueError(f\"Invalid base CIDR block: {e}\")\n\n    remove_nets = []\n    for cidr in remove:\n        try:\n            net = ipaddress.IPv4Network(cidr, strict=True)\n        except ValueError as e:\n            raise ValueError(f\"Invalid remove CIDR block '{cidr}': {e}\")\n        remove_nets.append(net)\n\n    # Start with the base network\n    remaining = [base_net]\n\n    for rem_net in remove_nets:\n        new_remaining = []\n        for net in remaining:\n            # If no overlap, keep the current network\n            if net.network_address > rem_net.broadcast_address or net.broadcast_address < rem_net.network_address:\n                new_remaining.append(net)\n                continue\n\n            # If completely covered, skip this network\n            if rem_net.network_address <= net.network_address and rem_net.broadcast_address >= net.broadcast_address:\n                continue\n\n            # Calculate the difference\n            diff = net.address_exclude(rem_net)\n            new_remaining.extend(diff)\n        remaining = new_remaining\n\n        if not remaining:\n            return []\n\n    # Convert to strings and sort by network address\n    result = [str(net) for net in sorted(remaining, key=lambda x: (x.network_address, x.prefixlen))]\n    return result\n```\n\nThis function:\n1. Validates the input CIDR blocks using `ipaddress.IPv4Network` with `strict=True` to catch malformed inputs\n2. Starts with the base network and iteratively subtracts each remove network\n3. Uses `address_exclude()` to compute the difference between networks\n4. Maintains the remaining networks after each subtraction\n5. Returns the result sorted by network address (and prefix length for networks with the same address)\n6. Handles all edge cases including:\n   - Remove networks that don't overlap with base\n   - Remove networks that completely cover base\n   - Overlapping remove networks\n   - Remove networks that extend beyond base\n\nThe function raises `ValueError` for any malformed input as specified."}
{"run_id": "full-r2", "item_id": "coding-011", "category": "coding", "title": "Add business days with holidays", "difficulty": "medium", "repeat": 1, "config_id": "l3", "config_label": "Mistral Large 3 (baseline)", "model": "mistral-large-2512", "reasoning_effort": null, "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 2844, "turns": 1, "retries": 1, "usage": {"search_calls": null, "output_tokens": 269, "reasoning_tokens": 0, "input_tokens": 231, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 1084, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 15, "failures": [], "pass": true, "load_error": null, "passed": 15}, "workflow_id": "0sfjc1495d1c-d02a-11f1-89ad-1a5d2f4e051b", "parent_workflow_id": "0sfjbd8273d2-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:16:15-0500", "answer": "```python\nfrom datetime import datetime, timedelta\n\ndef add_business_days(start: str, days: int, holidays: list[str]) -> str:\n    # Validate start date\n    try:\n        current = datetime.strptime(start, \"%Y-%m-%d\").date()\n    except ValueError:\n        raise ValueError(\"Invalid start date format\")\n\n    # Validate holiday dates\n    holiday_dates = set()\n    for holiday in holidays:\n        try:\n            holiday_date = datetime.strptime(holiday, \"%Y-%m-%d\").date()\n            holiday_dates.add(holiday_date)\n        except ValueError:\n            raise ValueError(\"Invalid holiday date format\")\n\n    if days == 0:\n        # Check if start is a business day\n        if current.weekday() < 5 and current not in holiday_dates:\n            return start\n        # Otherwise find the next business day\n        days = 1\n\n    step = 1 if days > 0 else -1\n    remaining = abs(days)\n\n    while remaining > 0:\n        current += timedelta(days=step)\n        if current.weekday() < 5 and current not in holiday_dates:\n            remaining -= 1\n\n    return current.strftime(\"%Y-%m-%d\")\n```"}
{"run_id": "full-r2", "item_id": "coding-010", "category": "coding", "title": "Optimal string alignment distance", "difficulty": "medium", "repeat": 1, "config_id": "l3", "config_label": "Mistral Large 3 (baseline)", "model": "mistral-large-2512", "reasoning_effort": null, "pass": false, "score": 0.6154, "api_ok": true, "error": null, "latency_ms": 4824, "turns": 1, "retries": 1, "usage": {"search_calls": null, "output_tokens": 442, "reasoning_tokens": 0, "input_tokens": 154, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 1491, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 0.6154, "total": 13, "failures": [{"test": "assert osa_distance(\"ab\", \"ba\") == 1", "line": 5, "error": "AssertionError: "}, {"test": "assert osa_distance(\"abcdef\", \"badcfe\") == 3", "line": 7, "error": "AssertionError: "}, {"test": "assert osa_distance(\"abc\", \"acb\") == 1", "line": 10, "error": "AssertionError: "}, {"test": "assert osa_distance(\"abcd\", \"acbd\") == 1", "line": 11, "error": "AssertionError: "}, {"test": "assert osa_distance(\"a cat\", \"an act\") == 2", "line": 13, "error": "AssertionError: "}], "pass": false, "load_error": null, "passed": 8}, "workflow_id": "0sfjc087457f-d02a-11f1-89ad-1a5d2f4e051b", "parent_workflow_id": "0sfjbd8273cf-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:16:21-0500", "answer": "```python\ndef osa_distance(a: str, b: str) -> int:\n    \"\"\"\n    Compute the Optimal String Alignment (OSA) distance between two strings.\n    The OSA distance is the minimum number of edits (insertions, deletions,\n    substitutions, and adjacent transpositions) required to turn string `a`\n    into string `b`, with the restriction that no substring is edited more\n    than once.\n    \"\"\"\n    len_a, len_b = len(a), len(b)\n\n    # Handle the trivial cases\n    if len_a == 0:\n        return len_b\n    if len_b == 0:\n        return len_a\n\n    # Initialize the previous row (d[i-1][*]) and the row before that (d[i-2][*])\n    prev_prev_row = list(range(len_b + 1))  # d[i-2][*]\n    prev_row = [0] * (len_b + 1)            # d[i-1][*]\n\n    for i in range(1, len_a + 1):\n        prev_row[0] = i\n        for j in range(1, len_b + 1):\n            # Cost of substitution or no change\n            cost = 0 if a[i - 1] == b[j - 1] else 1\n            prev_row[j] = min(\n                prev_row[j - 1] + 1,      # Insertion\n                prev_prev_row[j] + 1,     # Deletion\n                prev_prev_row[j - 1] + cost  # Substitution\n            )\n\n            # Check for adjacent transposition (if possible)\n            if i > 1 and j > 1 and a[i - 1] == b[j - 2] and a[i - 2] == b[j - 1]:\n                prev_row[j] = min(prev_row[j], prev_prev_row[j - 2] + 1)\n\n        # Swap rows for the next iteration\n        prev_prev_row, prev_row = prev_row, prev_prev_row\n\n    return prev_prev_row[len_b]\n```"}
{"run_id": "full-r2", "item_id": "coding-009", "category": "coding", "title": "Exact arithmetic expression evaluator", "difficulty": "hard", "repeat": 1, "config_id": "l3", "config_label": "Mistral Large 3 (baseline)", "model": "mistral-large-2512", "reasoning_effort": null, "pass": false, "score": 0.95, "api_ok": true, "error": null, "latency_ms": 11882, "turns": 1, "retries": 1, "usage": {"search_calls": null, "output_tokens": 1138, "reasoning_tokens": 0, "input_tokens": 355, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 4586, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 0.95, "total": 20, "failures": [{"test": "assert evaluate(\"2 ** -1\") == Fraction(1, 2)", "line": 16, "error": "ValueError: Unexpected operator: -"}], "pass": false, "load_error": null, "passed": 19}, "workflow_id": "0sfjc13a787c-d02a-11f1-aff9-321d2204384c", "parent_workflow_id": "0sfjbd8273d0-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:16:27-0500", "answer": "Here's a Python function that evaluates arithmetic expressions exactly as specified, using the `fractions.Fraction` type and without using `eval`, `exec`, `compile`, or the `ast` module. The solution involves tokenizing the input string, parsing it into an abstract syntax tree (AST) according to the specified grammar, and then evaluating the AST.\n\n```python\nfrom fractions import Fraction\nfrom typing import List, Union, Tuple\n\ndef evaluate(expr: str) -> Fraction:\n    tokens = tokenize(expr)\n    if not tokens:\n        raise ValueError(\"Empty expression\")\n    ast, remaining = parse_expression(tokens)\n    if remaining:\n        raise ValueError(\"Unexpected tokens at end of expression\")\n    return evaluate_ast(ast)\n\ndef tokenize(expr: str) -> List[str]:\n    tokens = []\n    i = 0\n    n = len(expr)\n    while i < n:\n        c = expr[i]\n        if c.isspace():\n            i += 1\n            continue\n        if c in '()+-*/**':\n            if c == '*' and i + 1 < n and expr[i+1] == '*':\n                tokens.append('**')\n                i += 2\n            else:\n                tokens.append(c)\n                i += 1\n            continue\n        if c.isdigit():\n            j = i\n            while j < n and expr[j].isdigit():\n                j += 1\n            tokens.append(expr[i:j])\n            i = j\n            continue\n        raise ValueError(f\"Unknown character: {c}\")\n    return tokens\n\ndef parse_expression(tokens: List[str]) -> Tuple[Union[List, str], List[str]]:\n    return parse_add_sub(tokens)\n\ndef parse_add_sub(tokens: List[str]) -> Tuple[Union[List, str], List[str]]:\n    left, tokens = parse_mul_div(tokens)\n    while tokens and tokens[0] in ('+', '-'):\n        op = tokens.pop(0)\n        right, tokens = parse_mul_div(tokens)\n        left = [op, left, right]\n    return left, tokens\n\ndef parse_mul_div(tokens: List[str]) -> Tuple[Union[List, str], List[str]]:\n    left, tokens = parse_unary(tokens)\n    while tokens and tokens[0] in ('*', '/'):\n        op = tokens.pop(0)\n        right, tokens = parse_unary(tokens)\n        left = [op, left, right]\n    return left, tokens\n\ndef parse_unary(tokens: List[str]) -> Tuple[Union[List, str], List[str]]:\n    if tokens and tokens[0] in ('+', '-'):\n        op = tokens.pop(0)\n        operand, tokens = parse_unary(tokens)\n        return [op, operand], tokens\n    return parse_exponent(tokens)\n\ndef parse_exponent(tokens: List[str]) -> Tuple[Union[List, str], List[str]]:\n    left, tokens = parse_atom(tokens)\n    if tokens and tokens[0] == '**':\n        op = tokens.pop(0)\n        right, tokens = parse_exponent(tokens)  # Right-associative\n        left = [op, left, right]\n    return left, tokens\n\ndef parse_atom(tokens: List[str]) -> Tuple[Union[List, str], List[str]]:\n    if not tokens:\n        raise ValueError(\"Missing operand\")\n    token = tokens.pop(0)\n    if token == '(':\n        expr, tokens = parse_expression(tokens)\n        if not tokens or tokens.pop(0) != ')':\n            raise ValueError(\"Unbalanced parentheses\")\n        return expr, tokens\n    if token in ('+', '-', '*', '/', '**'):\n        raise ValueError(f\"Unexpected operator: {token}\")\n    if not token.isdigit():\n        raise ValueError(f\"Invalid token: {token}\")\n    return token, tokens\n\ndef evaluate_ast(ast: Union[List, str]) -> Fraction:\n    if isinstance(ast, str):\n        return Fraction(int(ast))\n    if len(ast) == 2:  # Unary operator\n        op, operand = ast\n        val = evaluate_ast(operand)\n        if op == '+':\n            return val\n        elif op == '-':\n            return -val\n        else:\n            raise ValueError(f\"Unknown unary operator: {op}\")\n    elif len(ast) == 3:  # Binary operator\n        op, left, right = ast\n        left_val = evaluate_ast(left)\n        right_val = evaluate_ast(right)\n        if op == '+':\n            return left_val + right_val\n        elif op == '-':\n            return left_val - right_val\n        elif op == '*':\n            return left_val * right_val\n        elif op == '/':\n           "}
{"run_id": "full-r2", "item_id": "coding-009", "category": "coding", "title": "Exact arithmetic expression evaluator", "difficulty": "hard", "repeat": 1, "config_id": "sol_high", "config_label": "GPT-6.1 Sol (reasoning high)", "model": "gpt-6.1-sol", "reasoning_effort": "high", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 42795, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 2328, "reasoning_tokens": 1536, "input_tokens": 355, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 3631, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 20, "failures": [], "pass": true, "load_error": null, "passed": 20}, "workflow_id": "0sfjc13a787d-d02a-11f1-aff9-321d2204384c", "parent_workflow_id": "0sfjbd8273d0-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:16:35-0500", "answer": "```python\nfrom fractions import Fraction\n\n\ndef evaluate(expr: str) -> Fraction:\n    precedence = {\n        \"+\": 1, \"-\": 1,\n        \"*\": 2, \"/\": 2,\n        \"u+\": 3, \"u-\": 3,\n        \"**\": 4,\n    }\n    operators: list[str] = []\n    postfix: list[int | str] = []\n    expecting_operand = True\n    i = 0\n\n    # Validate the syntax and produce postfix notation before evaluating.\n    while i < len(expr):\n        ch = expr[i]\n\n        if ch.isspace():\n            i += 1\n            continue\n\n        if \"0\" <= ch <= \"9\":\n            if not expecting_operand:\n                raise ValueError(\"Two operands in a row\")\n\n            # Avoid the digit-count limit imposed on int(string).\n            number = 0\n            while i < len(expr) and \"0\" <= expr[i] <= \"9\":\n                number = number * 10 + ord(expr[i]) - ord(\"0\")\n                i += 1\n\n            postfix.append(number)\n            expecting_operand = False\n            continue\n\n        if ch == \"(\":\n            if not expecting_operand:\n                raise ValueError(\"Missing operator before '('\")\n            operators.append(ch)\n            i += 1\n            continue\n\n        if ch == \")\":\n            if expecting_operand:\n                raise ValueError(\"Missing operand before ')'\")\n\n            while operators and operators[-1] != \"(\":\n                postfix.append(operators.pop())\n\n            if not operators:\n                raise ValueError(\"Unmatched ')'\")\n            operators.pop()\n            i += 1\n            continue\n\n        if ch not in \"+-*/\":\n            raise ValueError(f\"Unknown character: {ch!r}\")\n\n        if expr.startswith(\"**\", i):\n            op = \"**\"\n            i += 2\n        else:\n            op = ch\n            i += 1\n\n        if expecting_operand:\n            if op not in (\"+\", \"-\"):\n                raise ValueError(\"Missing operand\")\n\n            # Prefix operators do not pop preceding operators. In particular,\n            # this permits unary signs on the right-hand side of '**'.\n            operators.append(\"u\" + op)\n            continue\n\n        while operators and operators[-1] != \"(\":\n            top = operators[-1]\n            if precedence[top] < precedence[op]:\n                break\n            if precedence[top] == precedence[op] and op == \"**\":\n                break\n            postfix.append(operators.pop())\n\n        operators.append(op)\n        expecting_operand = True\n\n    if expecting_operand:\n        raise ValueError(\"Empty expression or missing operand\")\n\n    while operators:\n        op = operators.pop()\n        if op == \"(\":\n            raise ValueError(\"Unmatched '('\")\n        postfix.append(op)\n\n    values: list[Fraction] = []\n\n    for token in postfix:\n        if isinstance(token, int):\n            values.append(Fraction(token))\n        elif token == \"u+\":\n            continue\n        elif token == \"u-\":\n            values[-1] = -values[-1]\n        else:\n            right = values.pop()\n            left = values.pop()\n\n            if token == \"+\":\n                result = left + right\n            elif token == \"-\":\n                result = left - right\n            elif token == \"*\":\n                result = left * right\n            elif token == \"/\":\n                result = left / right\n            else:  # **\n                if right.denominator != 1:\n                    raise ValueError(\"Exponent must be an integer\")\n                if left == 0 and right.numerator < 0:\n                    raise ZeroDivisionError(\"Zero raised to a negative power\")\n                result = left ** right.numerator\n\n            values.append(result)\n\n    return values[0]\n```"}
{"run_id": "full-r2", "item_id": "coding-007", "category": "coding", "title": "Glob matching with character classes", "difficulty": "hard", "repeat": 1, "config_id": "l4_off", "config_label": "Mistral Large 4 (reasoning off)", "model": "mistral-large-4", "reasoning_effort": "none", "pass": false, "score": 0.95, "api_ok": true, "error": null, "latency_ms": 59931, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 11084, "reasoning_tokens": 0, "input_tokens": 294, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 39620, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 0.95, "total": 20, "failures": [{"test": "assert glob_match(\"[]]x\", \"]x\")", "line": 11, "error": "AssertionError: "}], "pass": false, "load_error": null, "passed": 19}, "workflow_id": "0sfjbef90429-d02a-11f1-89ad-1a5d2f4e051b", "parent_workflow_id": "0sfjbd824cbd-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:16:45-0500", "answer": "Looking at this problem, I need to implement a glob matcher with specific semantics. Let me break down the requirements:\n\n1. `?` matches exactly one character except `/`\n2. `*` matches any sequence without `/`\n3. `**` matches any sequence including `/` (no special path-segment meaning)\n4. `[...]` character classes with negation, ranges, and literal `]`/`-` handling\n5. `\\` escapes outside sets, literal at end\n6. `[` without closing `]` is literal\n\nThe key insight is that `**` is just two `*`s that together can match `/`, but since `*` alone can't match `/`, I need to handle `**` as a special token. Actually, re-reading: `**` matches any sequence including `/`. So `**` is a distinct token from `*`.\n\nLet me think about the approach. I'll use dynamic programming or recursive matching with memoization. Given the complexity, I'll parse the pattern into tokens first, then match.\n\nActually, a cleaner approach: use a recursive matcher with index pointers, handling the pattern left-to-right.\n\nLet me write this carefully:\n\n```python\ndef glob_match(pattern: str, name: str) -> bool:\n    def match(p_idx: int, n_idx: int) -> bool:\n        # Memoization could help but let's try without first for clarity\n        # Actually with ** and *, we need to be careful about exponential blowup\n        # Let's use memoization\n        if (p_idx, n_idx) in memo:\n            return memo[(p_idx, n_idx)]\n\n        result = _match(p_idx, n_idx)\n        memo[(p_idx, n_idx)] = result\n        return result\n\n    def _match(p_idx: int, n_idx: int) -> bool:\n        while p_idx < len(pattern):\n            c = pattern[p_idx]\n\n            # Handle escape\n            if c == '\\\\':\n                if p_idx + 1 < len(pattern):\n                    # Escaped character - literal match\n                    if n_idx >= len(name) or name[n_idx] != pattern[p_idx + 1]:\n                        return False\n                    p_idx += 2\n                    n_idx += 1\n                    continue\n                else:\n                    # Trailing backslash matches literal backslash\n                    if n_idx >= len(name) or name[n_idx] != '\\\\':\n                        return False\n                    p_idx += 1\n                    n_idx += 1\n                    continue\n\n            # Handle **\n            if c == '*' and p_idx + 1 < len(pattern) and pattern[p_idx + 1] == '*':\n                # ** matches any sequence including /\n                # Try matching 0 or more characters\n                # We need to try all possible splits\n                # Optimization: if rest of pattern is empty, just consume all\n                if p_idx + 2 == len(pattern):\n                    return n_idx <= len(name)  # consume everything remaining\n\n                # Try matching 0, 1, 2, ... characters\n                for new_n in range(n_idx, len(name) + 1):\n                    if match(p_idx + 2, new_n):\n                        return True\n                return False\n\n            # Handle *\n            if c == '*':\n                # * matches any sequence without /\n                # Find how many non-/ characters we can consume\n                if p_idx + 1 == len(pattern):\n                    # Trailing *, consume all non-/ characters\n                    while n_idx < len(name) and name[n_idx] != '/':\n                        n_idx += 1\n                    return n_idx == len(name)\n\n                # Try consuming 0 or more non-/ characters\n                max_consume = n_idx\n                while max_consume < len(name) and name[max_consume] != '/':\n                    max_consume += 1\n\n                for new_n in range(n_idx, max_consume + 1):\n                    if match(p_idx + 1, new_n):\n                        return True\n                return False\n\n            # Handle ?\n            if c == '?':\n                if n_idx >= len(name) or name[n_idx] == '/':\n                    return False\n                p_idx += 1\n                n_idx += 1\n                continue\n\n            # Hand"}
{"run_id": "full-r2", "item_id": "coding-007", "category": "coding", "title": "Glob matching with character classes", "difficulty": "hard", "repeat": 1, "config_id": "sol_high", "config_label": "GPT-6.1 Sol (reasoning high)", "model": "gpt-6.1-sol", "reasoning_effort": "high", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 77259, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 4210, "reasoning_tokens": 3584, "input_tokens": 308, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 2567, "finish_reason": "stop", "thinking_chars": 0, "detail": {"score": 1.0, "total": 20, "failures": [], "pass": true, "load_error": null, "passed": 20}, "workflow_id": "0sfjbef92b3d-d02a-11f1-89ad-1a5d2f4e051b", "parent_workflow_id": "0sfjbd824cbd-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:17:02-0500", "answer": "```python\ndef glob_match(pattern: str, name: str) -> bool:\n    # After each pattern token, dp[j] indicates a match of name[:j].\n    dp = bytearray(len(name) + 1)\n    dp[0] = 1\n    i = 0\n    plen = len(pattern)\n    last_close = pattern.rfind(\"]\")\n\n    while i < plen:\n        char = pattern[i]\n        i += 1\n\n        if char == \"*\":\n            crosses_slash = i < plen and pattern[i] == \"*\"\n            while i < plen and pattern[i] == \"*\":\n                i += 1\n\n            for j, candidate in enumerate(name, 1):\n                dp[j] = dp[j] or (\n                    dp[j - 1] and (crosses_slash or candidate != \"/\")\n                )\n            continue\n\n        if char == \"?\":\n            for j in range(len(name), 0, -1):\n                dp[j] = dp[j - 1] and name[j - 1] != \"/\"\n            dp[0] = 0\n            continue\n\n        if char == \"[\":\n            start = i\n            negated = start < plen and pattern[start] in \"!^\"\n            if negated:\n                start += 1\n\n            search_from = start\n            if search_from < plen and pattern[search_from] == \"]\":\n                search_from += 1\n\n            # This guard also avoids repeated failed scans for unmatched '['.\n            if search_from <= last_close:\n                end = pattern.find(\"]\", search_from)\n                intervals = []\n                k = start\n\n                while k < end:\n                    if k + 2 < end and pattern[k + 1] == \"-\":\n                        intervals.append((pattern[k], pattern[k + 2]))\n                        k += 3\n                    else:\n                        intervals.append((pattern[k], pattern[k]))\n                        k += 1\n\n                i = end + 1\n                for j in range(len(name), 0, -1):\n                    candidate = name[j - 1]\n                    dp[j] = (\n                        dp[j - 1]\n                        and candidate != \"/\"\n                        and (\n                            any(\n                                low <= candidate <= high\n                                for low, high in intervals\n                            )\n                            != negated\n                        )\n                    )\n                dp[0] = 0\n                continue\n\n            # An unmatched '[' is handled as an ordinary literal below.\n\n        if char == \"\\\\\" and i < plen:\n            char = pattern[i]\n            i += 1\n\n        for j in range(len(name), 0, -1):\n            dp[j] = dp[j - 1] and name[j - 1] == char\n        dp[0] = 0\n\n    return bool(dp[len(name)])\n```"}
{"run_id": "full-r2", "item_id": "coding-010", "category": "coding", "title": "Optimal string alignment distance", "difficulty": "medium", "repeat": 1, "config_id": "l4_high", "config_label": "Mistral Large 4 (reasoning high)", "model": "mistral-large-4", "reasoning_effort": "high", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 89985, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 15257, "reasoning_tokens": 14964, "input_tokens": 152, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 805, "finish_reason": "stop", "thinking_chars": 45923, "detail": {"score": 1.0, "total": 13, "failures": [], "pass": true, "load_error": null, "passed": 13}, "workflow_id": "0sfjc0874581-d02a-11f1-89ad-1a5d2f4e051b", "parent_workflow_id": "0sfjbd8273cf-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:17:18-0500", "answer": "```python\ndef osa_distance(a: str, b: str) -> int:\n    m, n = len(a), len(b)\n\n    d = [[0] * (n + 1) for _ in range(m + 1)]\n\n    for i in range(m + 1):\n        d[i][0] = i\n    for j in range(n + 1):\n        d[0][j] = j\n\n    for i in range(1, m + 1):\n        for j in range(1, n + 1):\n            cost = 0 if a[i - 1] == b[j - 1] else 1\n\n            d[i][j] = min(\n                d[i - 1][j] + 1,          # deletion\n                d[i][j - 1] + 1,          # insertion\n                d[i - 1][j - 1] + cost    # substitution\n            )\n\n            if (\n                i > 1\n                and j > 1\n                and a[i - 1] == b[j - 2]\n                and a[i - 2] == b[j - 1]\n            ):\n                d[i][j] = min(d[i][j], d[i - 2][j - 2] + 1)  # transposition\n\n    return d[m][n]\n```"}
{"run_id": "full-r2", "item_id": "coding-012", "category": "coding", "title": "Token bucket rate limiter", "difficulty": "medium", "repeat": 1, "config_id": "l4_high", "config_label": "Mistral Large 4 (reasoning high)", "model": "mistral-large-4", "reasoning_effort": "high", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 124921, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 12853, "reasoning_tokens": 12623, "input_tokens": 249, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 980, "finish_reason": "stop", "thinking_chars": 50477, "detail": {"score": 1.0, "total": 13, "failures": [], "pass": true, "load_error": null, "passed": 13}, "workflow_id": "0sfjbfbc1060-d02a-11f1-ba7a-56adf5b8ca14", "parent_workflow_id": "0sfjbd8273ce-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:17:51-0500", "answer": "```python\ndef token_bucket(capacity: int, refill_per_sec: float, requests: list[tuple[float, int]]) -> list[bool]:\n    if capacity < 1:\n        raise ValueError(\"capacity must be at least 1\")\n    if refill_per_sec < 0:\n        raise ValueError(\"refill_per_sec must be non-negative\")\n\n    tokens = capacity\n    last_time = None\n    result = []\n\n    for timestamp, cost in requests:\n        if not isinstance(cost, int) or isinstance(cost, bool) or cost < 1:\n            raise ValueError(\"cost must be an integer >= 1\")\n        if last_time is not None and timestamp < last_time:\n            raise ValueError(\"timestamps must be non-decreasing\")\n\n        if last_time is not None:\n            elapsed = timestamp - last_time\n            tokens = min(capacity, tokens + elapsed * refill_per_sec)\n\n        last_time = timestamp\n\n        if tokens >= cost:\n            tokens -= cost\n            result.append(True)\n        else:\n            result.append(False)\n\n    return result\n```"}
{"run_id": "full-r2", "item_id": "coding-009", "category": "coding", "title": "Exact arithmetic expression evaluator", "difficulty": "hard", "repeat": 1, "config_id": "l4_high", "config_label": "Mistral Large 4 (reasoning high)", "model": "mistral-large-4", "reasoning_effort": "high", "pass": true, "score": 1.0, "api_ok": true, "error": null, "latency_ms": 164234, "turns": 1, "retries": 0, "usage": {"search_calls": null, "output_tokens": 25660, "reasoning_tokens": 24707, "input_tokens": 349, "search_tokens": null, "cached_input_tokens": 0}, "answer_chars": 3997, "finish_reason": "stop", "thinking_chars": 89055, "detail": {"score": 1.0, "total": 20, "failures": [], "pass": true, "load_error": null, "passed": 20}, "workflow_id": "0sfjc13a516b-d02a-11f1-aff9-321d2204384c", "parent_workflow_id": "0sfjbd8273d0-d02a-11f1-ba7a-56adf5b8ca14", "recorded_at": "2026-10-24T23:18:33-0500", "answer": "```python\nfrom fractions import Fraction\n\n\nclass _Scanner:\n    def __init__(self, text: str):\n        self.text = text\n        self.pos = 0\n        self.n = len(text)\n\n    def next_token(self):\n        while self.pos < self.n and self.text[self.pos].isspace():\n            self.pos += 1\n\n        if self.pos >= self.n:\n            return ('EOF', None)\n\n        c = self.text[self.pos]\n\n        if '0' <= c <= '9':\n            start = self.pos\n            while self.pos < self.n and '0' <= self.text[self.pos] <= '9':\n                self.pos += 1\n            return ('NUM', int(self.text[start:self.pos]))\n\n        if c == '+':\n            self.pos += 1\n            return ('PLUS', None)\n        if c == '-':\n            self.pos += 1\n            return ('MINUS', None)\n        if c == '*':\n            if self.pos + 1 < self.n and self.text[self.pos + 1] == '*':\n                self.pos += 2\n                return ('POWER', None)\n            self.pos += 1\n            return ('STAR', None)\n        if c == '/':\n            self.pos += 1\n            return ('SLASH', None)\n        if c == '(':\n            self.pos += 1\n            return ('LPAREN', None)\n        if c == ')':\n            self.pos += 1\n            return ('RPAREN', None)\n\n        raise ValueError(f\"unknown character: {c!r}\")\n\n\nclass _Parser:\n    def __init__(self, text: str):\n        self.scanner = _Scanner(text)\n        self.current = self.scanner.next_token()\n\n    def eat(self, kind: str):\n        if self.current[0] != kind:\n            raise ValueError(f\"expected {kind}, got {self.current[0]}\")\n        self.current = self.scanner.next_token()\n\n    def parse(self) -> Fraction:\n        if self.current[0] == 'EOF':\n            raise ValueError(\"empty expression\")\n\n        result = self.parse_expr()\n\n        if self.current[0] != 'EOF':\n            raise ValueError(\"unexpected token\")\n\n        return result\n\n    def parse_expr(self) -> Fraction:\n        node = self.parse_term()\n\n        while self.current[0] in ('PLUS', 'MINUS'):\n            op = self.current[0]\n            self.eat(op)\n            right = self.parse_term()\n\n            if op == 'PLUS':\n                node = node + right\n            else:\n                node = node - right\n\n        return node\n\n    def parse_term(self) -> Fraction:\n        node = self.parse_factor()\n\n        while self.current[0] in ('STAR', 'SLASH'):\n            op = self.current[0]\n            self.eat(op)\n            right = self.parse_factor()\n\n            if op == 'STAR':\n                node = node * right\n            else:\n                if right == 0:\n                    raise ZeroDivisionError(\"division by zero\")\n                node = node / right\n\n        return node\n\n    def parse_factor(self) -> Fraction:\n        sign = 1\n\n        while self.current[0] in ('PLUS', 'MINUS'):\n            if self.current[0] == 'MINUS':\n                sign = -sign\n            self.eat(self.current[0])\n\n        result = self.parse_power()\n        return result if sign == 1 else -result\n\n    def parse_power(self) -> Fraction:\n        base = self.parse_primary()\n\n        if self.current[0] == 'POWER':\n            self.eat('POWER')\n            exponent = self.parse_factor()\n\n            if exponent.denominator != 1:\n                raise ValueError(\"non-integer exponent\")\n\n            exp_int = exponent.numerator\n\n            if base == 0 and exp_int < 0:\n                raise ZeroDivisionError(\"0 cannot be raised to a negative power\")\n\n            return base ** exp_int\n\n        return base\n\n    def parse_primary(self) -> Fraction:\n        if self.current[0] == 'NUM':\n            val = self.current[1]\n            self.eat('NUM')\n            return Fraction(val, 1)\n\n        if self.current[0] == 'LPAREN':\n            self.eat('LPAREN')\n            result = self.parse_expr()\n            self.eat('RPAREN')\n            return result\n\n        raise ValueError(\"missing operand\")\n\n\ndef evaluate(expr: str) -> Fraction:\n    return _Parser(expr).parse()\n```"}
