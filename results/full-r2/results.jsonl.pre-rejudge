 = Sunday\n- Oct 13: Thursday + 31+28+31+30+31+30+31+31+30+12 = Thursday + 285 = Thursday + 5 = Tuesday\n- Nov 13: Thursday + 31+28+31+30+31+30+31+31+30+31+12 = Thursday + 316 = Thursday + 1 = Friday \u2713 **Friday the 13th**\n- Dec 13: Thursday + 31+28+31+30+31+30+31+31+30+31+30+12 = Thursday + 346 = Thursday + 3 = Sunday\n\n2026: Feb, Mar, Nov = **3 Friday the 13ths**\n\nJanuary 1, 2027: 2026 has 365 days, so Thursday + 1 = Friday\n\n**2027** (starts Friday, not a leap year):\n- Jan 13: Friday + 12 = Wednesday\n- Feb 13: Friday + 31 + 12 = Friday + 43 = Friday + 1 = Saturday\n- Mar 13: Friday + 31 + 28 + 12 = Friday + 71 = Friday + 1 = Saturday\n- Apr 13: Friday + 102 = Friday + 4 = Tuesday\n- May 13: Friday + 132 = Friday + 6 = Thursday\n- Jun 13: Friday + 163 = Friday + 2 = Sunday\n- Jul 13: Friday + 193 = Friday + 4 = Tuesday\n- Aug 13: Friday + 224 = Friday + 0 = Friday \u2713 **Friday the 13th**\n- Sep 13: Friday + 255 = Friday + 3 = Monday\n- Oct 13: Friday + 285 = Friday + 5 = Wednesday\n- Nov 13: Friday + 316 = Friday + 1 = Saturday\n- Dec 13: Friday + 346 = Friday + 3 = Monday\n\n2027: Aug = **1 Friday the 13th**\n\nJanuary 1, 2028: 2027 has 365 days, so Friday + 1 = Saturday\n\n**2028** (starts Saturday, leap year):\n- Jan 13: Saturday + 12 = Thursday\n- Feb 13: Saturday + 31 + 12 = Saturday + 43 = Saturday + 1 = Sunday\n- Mar 13: Saturday + 31 + 29 + 12 = Saturday + 72 = Saturday + 2 = Monday\n- Apr 13: Saturday + 31+29+31+12 = Saturday + 103 = Saturday + 5 = Thursday\n- May 13: Saturday + 31+29+31+30+12 = Saturday + 133 = Saturday + 0 = Saturday\n- Jun 13: Saturday + 31+29+31+30+31+12 = Saturday + 164 = Saturday + 3 = Tuesday\n- Jul 13: Saturday + 31+29+31+30+31+30+12 = Saturday + 194 = Saturday + 5 = Thursday\n- Aug 13: Saturday + 31+29+31+30+31+30+31+12 = Saturday + 225 = Saturday + 1 = Sunday\n- Sep 13: Saturday + 31+29+31+30+31+30+31+31+12 = Saturday + 256 = Saturday + 4 = Wednesday\n- Oct 13: Saturday + 31+29+31+30+31+30+31+31+30+12 = Saturday + 286 = Saturday + 6 = Friday \u2713 **Friday the 13th**\n- Nov 13: Saturday + 31+29+31+30+31+30+31+31+30+31+12 = Saturday + 317 = Saturday + 2 = Monday\n- Dec 13: Saturday + 31+29+31+30+31+30+31+31+30+31+30+12 = Saturday + 347 = Saturday + 4 = Wednesday\n\n2028: Oct = **1 Friday the 13th**\n\nJanuary 1, 2029: 2028 is a leap year (366 days), so Saturday + 2 = Monday\n\n**2029** (starts Monday, not a leap year):\n- Jan 13: Monday + 12 = Saturday\n- Feb 13: Monday + 31 + 12 = Monday + 43 = Monday + 1 = Tuesday\n- Mar 13: Monday + 71 = Monday + 1 = Tuesday\n- Apr 13: Monday + 102 = Monday + 4 = Friday \u2713 **Friday the 13th**\n- May 13: Monday + 132 = Monday + 6 = Sunday\n- Jun 13: Monday + 163 = Monday + 2 = Wednesday\n- Jul 13: Monday + 193 = Monday + 4 = Friday \u2713 **Friday the 13th**\n- Aug 13: Monday + 224 = Monday + 0 = Monday\n- Sep 13: Monday + 255 = Monday + 3 = Thursday\n- Oct 13: Monday + 285 = Monday + 5 = Saturday\n- Nov 13: Monday + 316 = Monday + 1 = Tuesday\n- De"}
